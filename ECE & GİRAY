<!DOCTYPE html>  
<html lang="tr">  
<head>  
  <meta charset="UTF-8">  
  <meta name="viewport" content="width=device-width, initial-scale=1.0">  
  <title>Ece & Giray Düğün Albümü</title>  
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css" />  
  <style>  
    body {  
      background: url('https://i.imgur.com/OZR9h4x.jpeg') no-repeat center center fixed;  
      background-size: cover;  
      color: white;  
      font-family: Arial, sans-serif;  
      margin: 0;  
      padding: 0;  
      height: 100vh;  
      overflow-y: auto;  
    }  
    .overlay {  
      background-color: rgba(0, 0, 0, 0.6);  
      position: absolute;  
      top: 0;  
      left: 0;  
      width: 100%;  
      min-height: 100%;  
      padding: 20px;  
      box-sizing: border-box;  
    }  
    .header {  
      text-align: center;  
      margin-bottom: 20px;  
    }  
    .header h1 {  
      font-size: 3em;  
      margin-bottom: 10px;  
    }  
    .header p {  
      font-size: 1.2em;  
      max-width: 600px;  
      margin: 0 auto;  
    }  
    .upload-section {  
      text-align: center;  
      margin: 20px 0;  
    }  
    .gallery {  
      display: flex;  
      flex-wrap: wrap;  
      gap: 15px;  
      justify-content: center;  
    }  
    .image-container {  
      position: relative;  
      width: 200px;  
      height: 200px;  
    }  
    .gallery img {  
      width: 100%;  
      height: 100%;  
      object-fit: cover;  
      border-radius: 5px;  
    }  
    .image-actions {  
      position: absolute;  
      top: 5px;  
      right: 5px;  
      display: flex;  
      gap: 5px;  
    }  
    .edit-btn, .delete-btn {  
      background: rgba(0,0,0,0.5);  
      color: white;  
      border: none;  
      border-radius: 3px;  
      padding: 5px;  
      cursor: pointer;  
    }  
    .modal {  
      display: none;  
      position: fixed;  
      top: 0;  
      left: 0;  
      width: 100%;  
      height: 100%;  
      background-color: rgba(0,0,0,0.9);  
      z-index: 100;  
      justify-content: center;  
      align-items: center;  
    }  
    .modal-content {  
      max-width: 80%;  
      max-height: 80%;  
    }  
    .modal img {  
      max-width: 100%;  
      max-height: 80vh;  
    }  
    .modal-actions {  
      margin-top: 10px;  
      text-align: center;  
    }  
    .modal-actions button {  
      background: #4CAF50;  
      color: white;  
      border: none;  
      padding: 10px 20px;  
      margin: 0 5px;  
      cursor: pointer;  
    }  
  </style>  
</head>  
<body>  
  <div class="overlay">  
    <div class="header">  
      <h1>Ece & Giray Düğün Albümü</h1>  
      <p>Düğünümüze hoşgeldiniz. Fotoğraflarınızı dijital albümümüze ekleyebilirsiniz. Hemen fotoğraf yüklemeye başlayın ve bu mutlu günü birlikte hatırlayalım.</p>  
    </div>  
    <div class="upload-section">  
      <input type="file" id="fileInput" accept="image/*" multiple>  
    </div>  
    <div class="gallery" id="gallery"></div>  
  </div>  
  <div id="editModal" class="modal">  
    <div class="modal-content">  
      <img id="imageToEdit" src="" alt="Düzenlenecek Görsel">  
      <div class="modal-actions">  
        <button id="cropBtn">Kırp</button>  
        <button id="cancelBtn">İptal</button>  
      </div>  
    </div>  
  </div>  
  <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.js"></script>  
  <script>  
    // Elemanların Tanımlanması  
    const fileInput = document.getElementById('fileInput');  
    const gallery = document.getElementById('gallery');  
    const editModal = document.getElementById('editModal');  
    const imageToEdit = document.getElementById('imageToEdit');  
    const cropBtn = document.getElementById('cropBtn');  
    const cancelBtn = document.getElementById('cancelBtn');  
    
    let currentImage = null;  
    let cropper = null;  
    
    // Dosya Seçimi İşlemi  
    fileInput.addEventListener('change', function(e) {  
      const files = e.target.files;  
      for (let i = 0; i < files.length; i++) {  
        const file = files[i];  
        if (!file.type.match('image.*')) continue;  
        const reader = new FileReader();  
        reader.onload = function(event) {  
          addImageToGallery(event.target.result);  
        };  
        reader.readAsDataURL(file);  
      }  
    });  
    
    // Galeriye Görsel Eklenmesi  
    function addImageToGallery(src) {  
      const container = document.createElement('div');  
      container.className = 'image-container';  
      const img = document.createElement('img');  
      img.src = src;  
      container.appendChild(img);  
      
      const actions = document.createElement('div');  
      actions.className = 'image-actions';  
      const editBtn = document.createElement('button');  
      editBtn.className = 'edit-btn';  
      editBtn.textContent = 'Düzenle';  
      editBtn.addEventListener('click', function() {  
        openEditor(img);  
      });  
      const deleteBtn = document.createElement('button');  
      deleteBtn.className = 'delete-btn';  
      deleteBtn.textContent = 'Sil';  
      deleteBtn.addEventListener('click', function() {  
        gallery.removeChild(container);  
      });  
      actions.appendChild(editBtn);  
      actions.appendChild(deleteBtn);  
      container.appendChild(actions);  
      gallery.appendChild(container);  
    }  
    
    // Düzenleme Modunun Açılması  
    function openEditor(imgElement) {  
      currentImage = imgElement;  
      imageToEdit.src = imgElement.src;  
      editModal.style.display = 'flex';  
      if (cropper) {  
        cropper.destroy();  
      }  
      cropper = new Cropper(imageToEdit, {  
        aspectRatio: NaN,  
        viewMode: 1,  
        autoCropArea: 1  
      });  
    }  
    
    // Görselin Kırpılması  
    cropBtn.addEventListener('click', function() {  
      if (cropper) {  
        const croppedCanvas = cropper.getCroppedCanvas();  
        const croppedImage = croppedCanvas.toDataURL('image/jpeg');  
        currentImage.src = croppedImage;  
        editModal.style.display = 'none';  
        cropper.destroy();  
        cropper = null;  
      }  
    });  
    
    // Düzenleme İptali  
    cancelBtn.addEventListener('click', function() {  
      editModal.style.display = 'none';  
      if (cropper) {  
        cropper.destroy();  
        cropper = null;  
      }  
    });  
    
    // Modal dışına tıklama durumunda kapatma  
    editModal.addEventListener('click', function(e) {  
      if (e.target === editModal) {  
        editModal.style.display = 'none';  
        if (cropper) {  
          cropper.destroy();  
          cropper = null;  
        }  
      }  
    });  
  </script>  
</body>  
</html>  
